/* app.rc - Windows resources for pdfwatermark.exe */
#include <windows.h>

/* 1 ICON "..." -> LoadIconW(hInst, MAKEINTRESOURCEW(1)) in pdfwatermark.c */
1 ICON "watermark.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "EdmonJiang"
            VALUE "FileDescription",  "PDF Watermark"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "pdfwatermark"
            VALUE "LegalCopyright",   "MIT (links MuPDF, AGPL-3.0)"
            VALUE "OriginalFilename", "pdfwatermark.exe"
            VALUE "ProductName",      "PDF Watermark"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
